# Yahoo!商品検索 API の Client ID (アプリケーションID)
# https://e.developer.yahoo.co.jp/register で取得
YAHOO_APP_ID=your_yahoo_app_id_here

# Gemini API Key
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=your_gemini_api_key_here

# Turso Database
# https://turso.tech でアカウント作成後、DB作成して取得
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
